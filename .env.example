# Copy to .env locally, then load with: set -a; source .env; set +a
# Credentials belong in ~/.aws, AWS environment variables or an instance role.
AWS_PROFILE=landwise-hackathon
AWS_DEFAULT_REGION=us-west-2
BEDROCK_MODEL_ID=qwen.qwen3-32b-v1:0
BEDROCK_ENABLED=true
BEDROCK_MIN_INTERVAL=1.1
# local for offline development; use bedrock-kb on AWS with stack outputs below.
RAG_BACKEND=local
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_KB_DATA_SOURCE_ID=
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_PREFIX=landwise/
REFERENCE_DATA_DIR=../aws
FORM_TEMPLATE_DIR=out_put_teamplate
# paddleocr (default) or rapidocr; install the matching requirements file.
OCR_ENGINE=paddleocr
OCR_DPI=180
OCR_CPU_THREADS=2
OCR_TIMEOUT_SECONDS=300
OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
OCR_RECOGNITION_MODEL=PP-OCRv5_server_rec
